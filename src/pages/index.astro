---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getSiteConfig } from "../utils/config";
import { Icon } from "astro-icon";

const config = getSiteConfig();

// Get sample data for preview
const alumni = await getCollection("alumni");
const events = await getCollection("events");
const blogPosts = await getCollection("blog");

// Get featured alumni (first 3)
const featuredAlumni = alumni.slice(0, 3);

// Get latest events (first 4)
const latestEvents = events
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  .slice(0, 4);

// Get latest blog posts (first 3)
const latestBlogPosts = blogPosts
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime()
  )
  .slice(0, 3);
---

<Layout title={`${config.site.name} | Home`} description={config.site.description}>
  <!-- Hero Section with Sahyadri Campus Background -->
  <section class="hero section-sm bg-cover bg-center relative min-h-[80vh] flex items-center" style={`background-image: linear-gradient(rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.8)), url(${config.site.hero_image});`}>
    <div class="container-custom relative z-10 w-full py-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <!-- Left Side Text -->
        <div class="text-center lg:text-left">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-[#102a43] mb-6 leading-tight drop-shadow-sm">
            Connect with Your
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#2a4365] to-[#22c55e]">
              Alumni Network
            </span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-800 mb-8 leading-relaxed font-medium">
            Stay connected with fellow graduates, discover opportunities, and
            build lasting professional relationships.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="/alumni/profiles" class="bg-[#2a4365] text-white hover:bg-[#102a43] px-6 py-3 rounded-lg font-bold inline-flex items-center justify-center transition-colors shadow-md">
              <Icon name="mdi:account-search" class="w-6 h-6 mr-2" />
              Browse Alumni
            </a>
            <a href="/about" class="bg-white/80 backdrop-blur border-2 border-[#2a4365] text-[#2a4365] hover:bg-[#2a4365] hover:text-white px-6 py-3 rounded-lg font-bold inline-flex items-center justify-center transition-colors shadow-sm">
              <Icon name="mdi:information" class="w-6 h-6 mr-2" />
              Learn More
            </a>
          </div>
        </div>

        <!-- Right Side Glass Card -->
        <div class="relative max-w-md mx-auto w-full">
          <div class="relative z-10">
            <div class="bg-white/90 backdrop-blur-md rounded-3xl p-8 md:p-10 shadow-2xl border border-white">
              <div class="text-center">
                <Icon name="mdi:account-group" class="w-24 h-24 md:w-28 md:h-28 mx-auto mb-4 text-[#22c55e]" />
                <h3 class="text-2xl md:text-3xl font-bold mb-3 text-[#102a43]">
                  Join Our Network
                </h3>
                <p class="text-lg mb-8 text-gray-600 font-medium">
                  Connect with {alumni.length}+ alumni from {config.organization.name}
                </p>
                <div class="flex flex-col justify-center">
                  <a href="/join" class="w-full bg-[#22c55e] text-white hover:bg-[#16a34a] px-8 py-4 rounded-xl font-bold inline-flex items-center justify-center transition-all shadow-lg text-lg transform hover:-translate-y-1">
                    <Icon name="mdi:account-plus" class="w-6 h-6 mr-2" />
                    Join Now
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Decorative elements -->
          <div class="absolute -top-6 -right-6 w-24 h-24 bg-[#22c55e] rounded-full opacity-30 animate-pulse blur-xl"></div>
          <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-[#2a4365] rounded-full opacity-20 animate-pulse animation-delay-1000 blur-xl"></div>
        </div>

      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="section-sm bg-white border-y border-gray-100 shadow-sm relative z-20">
    <div class="container-custom">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-[#2a4365] rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-md">
            <Icon name="mdi:account-group" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-3xl font-bold text-[#102a43] mb-2">{alumni.length}+</h3>
          <p class="text-gray-500 font-bold uppercase tracking-wider text-sm">Alumni</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-[#22c55e] rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-md">
            <Icon name="mdi:school" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-3xl font-bold text-[#102a43] mb-2">{config.faculties.length}</h3>
          <p class="text-gray-500 font-bold uppercase tracking-wider text-sm">Departments</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-[#405a7a] rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-md">
            <Icon name="mdi:calendar" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-3xl font-bold text-[#102a43] mb-2">{config.years.end - config.years.start + 1}</h3>
          <p class="text-gray-500 font-bold uppercase tracking-wider text-sm">Years</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-[#102a43] rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-md">
            <Icon name="mdi:map-marker" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-3xl font-bold text-[#102a43] mb-2">Global</h3>
          <p class="text-gray-500 font-bold uppercase tracking-wider text-sm">Network</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Events Section -->
  <section class="section py-16 bg-[#f0f4f8]">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-[#102a43] mb-4">Upcoming Events</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Stay updated with the latest events, reunions, and networking opportunities.
        </p>
      </div>

      <div class="grid-responsive mb-12">
        {latestEvents.map((event) => (
            <div class="event-card group bg-white p-4 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all">
              <div class="relative mb-4 overflow-hidden rounded-xl">
                {event.data.image ? (
                  <img src={event.data.image} alt={event.data.title} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="w-full h-48 bg-[#f0f4f8] flex items-center justify-center">
                    <Icon name="mdi:calendar-event" class="w-16 h-16 text-[#829ab1]" />
                  </div>
                )}
                <div class="absolute top-4 right-4">
                  <span class="bg-[#2a4365] text-white px-3 py-1 rounded-full text-sm font-bold shadow-sm">
                    {new Date(event.data.date).toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                  </span>
                </div>
              </div>
              <h3 class="text-xl font-bold text-[#102a43] mb-2 group-hover:text-[#22c55e] transition-colors duration-200">
                {event.data.title}
              </h3>
              <p class="text-gray-600 mb-4 line-clamp-2">{event.data.description}</p>
              <div class="flex items-center justify-between mt-auto">
                <div class="flex items-center space-x-2 text-sm text-gray-500 font-medium">
                  <Icon name="mdi:map-marker" class="w-4 h-4" />
                  <span>{event.data.location}</span>
                </div>
                <a href={`/events/${event.data.slug}`} class="text-[#2a4365] hover:text-[#22c55e] font-bold inline-flex items-center transition-colors">
                  Details <Icon name="mdi:arrow-right" class="w-4 h-4 ml-1" />
                </a>
              </div>
            </div>
          ))}
      </div>
      <div class="text-center">
        <a href="/events" class="border-2 border-[#2a4365] text-[#2a4365] hover:bg-[#2a4365] hover:text-white px-8 py-3 rounded-lg font-bold inline-flex items-center transition-colors">
          <Icon name="mdi:calendar-multiple" class="w-6 h-6 mr-2" />
          View All Events
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Alumni Section -->
  <section class="section py-16 bg-white border-y border-gray-100">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-[#102a43] mb-4">Featured Alumni</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Meet some of our outstanding alumni who are making a difference in the tech industry.
        </p>
      </div>

      <div class="grid-responsive mb-12">
        {featuredAlumni.map((alum) => (
            <div class="profile-card text-center group bg-[#f0f4f8] p-8 rounded-2xl border border-gray-100 hover:shadow-lg transition-all">
              <div class="relative mb-6 flex justify-center">
                {alum.data.photo ? (
                  <img src={alum.data.photo} alt={alum.data.name} class="w-28 h-28 rounded-full object-cover shadow-md border-4 border-white group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                ) : (
                  <div class="w-28 h-28 rounded-full bg-[#2a4365] text-white flex items-center justify-center text-3xl font-bold shadow-md border-4 border-white group-hover:scale-105 transition-transform duration-300">
                    {alum.data.name.split(" ").map((n: string) => n[0]).join("").toUpperCase().substring(0,2)}
                  </div>
                )}
                <div class="absolute -bottom-3 bg-[#22c55e] text-white text-xs px-3 py-1 rounded-full shadow-sm font-bold border-2 border-white">
                  Class of {alum.data.year}
                </div>
              </div>
              
              <h3 class="text-xl font-bold text-[#102a43] mb-1">{alum.data.name}</h3>
              <p class="text-[#2a4365] font-semibold text-sm mb-4">{alum.data.faculty}</p>
              <p class="text-gray-600 text-sm mb-6 line-clamp-3">{alum.data.short_bio}</p>
              
              <a href={`/alumni/profiles/${alum.data.slug}`} class="block w-full bg-white border-2 border-[#2a4365] text-[#2a4365] hover:bg-[#2a4365] hover:text-white py-2.5 rounded-lg font-bold transition-colors mt-auto">
                View Profile
              </a>
            </div>
          ))}
      </div>
      <div class="text-center">
        <a href="/alumni/profiles" class="bg-[#2a4365] text-white hover:bg-[#102a43] px-8 py-3 rounded-lg font-bold inline-flex items-center transition-colors shadow-md">
          <Icon name="mdi:account-multiple" class="w-6 h-6 mr-2" />
          Meet More Alumni
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts Section -->
  <section class="section py-16 bg-[#f0f4f8]">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-[#102a43] mb-4">Latest Insights</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Stories, updates, and tech insights from our alumni community.
        </p>
      </div>

      <div class="grid-responsive mb-12">
        {latestBlogPosts.map((post) => (
            <div class="blog-card group bg-white p-5 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-all">
              <div class="relative mb-5 overflow-hidden rounded-xl">
                {post.data.image ? (
                  <img src={post.data.image} alt={post.data.title} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="w-full h-48 bg-[#f0f4f8] flex items-center justify-center">
                    <Icon name="mdi:newspaper" class="w-16 h-16 text-[#829ab1]" />
                  </div>
                )}
                <div class="absolute top-4 left-4">
                  <span class="bg-[#22c55e] text-white px-3 py-1 rounded-full text-xs font-bold shadow-sm uppercase tracking-wider">
                    {post.data.category}
                  </span>
                </div>
              </div>
              <h3 class="text-xl font-bold text-[#102a43] mb-3 group-hover:text-[#2a4365] transition-colors duration-200 line-clamp-2">
                {post.data.title}
              </h3>
              <p class="text-gray-600 mb-5 line-clamp-3">{post.data.description}</p>
              
              <div class="flex items-center justify-between text-sm mt-auto pt-4 border-t border-gray-100">
                <span class="text-gray-500 font-medium">
                  {new Date(post.data.publishDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                </span>
                <a href={`/blog/${post.slug}`} class="text-[#2a4365] hover:text-[#22c55e] font-bold inline-flex items-center transition-colors">
                  Read More <Icon name="mdi:arrow-right" class="w-4 h-4 ml-1" />
                </a>
              </div>
            </div>
          ))}
      </div>
      <div class="text-center">
        <a href="/blog" class="border-2 border-[#2a4365] text-[#2a4365] hover:bg-[#2a4365] hover:text-white px-8 py-3 rounded-lg font-bold inline-flex items-center transition-colors">
          <Icon name="mdi:newspaper" class="w-6 h-6 mr-2" />
          Read All Posts
        </a>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="section py-20 bg-gradient-to-br from-[#0b1e36] to-[#2a4365] relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden opacity-10 pointer-events-none">
      <Icon name="mdi:school" class="w-96 h-96 absolute -top-10 -left-20 text-white transform -rotate-12" />
      <Icon name="mdi:account-network" class="w-96 h-96 absolute -bottom-20 -right-20 text-white transform rotate-12" />
    </div>
    
    <div class="container-custom text-center relative z-10">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">Ready to Connect?</h2>
      <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto font-medium leading-relaxed">
        Join our thriving alumni network and stay connected with your fellow graduates. Discover opportunities, mentor students, and build lasting relationships.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/join" class="bg-[#22c55e] text-white hover:bg-[#16a34a] px-8 py-4 rounded-xl font-bold inline-flex items-center justify-center transition-all shadow-lg transform hover:-translate-y-1 text-lg">
          <Icon name="mdi:account-plus" class="w-6 h-6 mr-2" />
          Join the Network
        </a>
      </div>
    </div>
  </section>
</Layout>