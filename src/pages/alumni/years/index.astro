---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getSiteConfig } from '@/utils/config';
import { Icon } from 'astro-icon';

const config = getSiteConfig();
const years = Array.from({ length: config.years.end - config.years.start + 1 }, (_, i) => config.years.end - i);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Profiles', href: '/alumni' },
  { label: 'Years' },
];
---

<Layout title="Browse by Year | Sahyadri Alumni Network" description="Browse the Sahyadri alumni directory by graduation year.">
  
  <!-- Page Header -->
  <section class="bg-gradient-to-r from-[#0b1e36] to-[#2a4365] text-white py-12">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Browse by Year</h1>
      <p class="text-xl text-gray-200 max-w-2xl mx-auto">
        Explore our alumni network organized by graduation year.
      </p>
    </div>
  </section>

  <!-- Breadcrumbs Area -->
  <div class="bg-gray-50 py-3 border-b border-gray-200">
    <div class="container-custom">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="section py-12 bg-[#f0f4f8] min-h-screen">
    <div class="container-custom">
      
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {years.map(y => (
          <a 
            href={`/alumni/years/${y}`} 
            class="group bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md hover:border-[#22c55e] transition-all p-6 flex flex-col items-center justify-center text-center transform hover:-translate-y-1"
          >
            <Icon name="mdi:calendar-account" class="w-8 h-8 text-[#2a4365] group-hover:text-[#22c55e] mb-3 transition-colors duration-300" />
            <span class="text-2xl font-bold text-[#102a43] transition-colors">{y}</span>
            <span class="text-xs text-gray-500 mt-2 uppercase tracking-wider font-bold group-hover:text-[#22c55e] transition-colors">Class of {y}</span>
          </a>
        ))}
      </div>
      
    </div>
  </section>
</Layout>