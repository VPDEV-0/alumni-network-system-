---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a,b)=> new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog' },
];
---

<Layout title="Blog & News | Sahyadri Alumni Network" description="Read the latest news, stories, and insights from the Sahyadri alumni community.">
  
  <!-- Page Header -->
  <section class="bg-gradient-to-r from-[#0b1e36] to-[#2a4365] text-white py-12">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Latest News & Insights</h1>
      <p class="text-xl text-gray-200 max-w-2xl mx-auto">
        Stay informed with the latest updates, stories, and insights from our alumni community.
      </p>
    </div>
  </section>

  <!-- Breadcrumbs Area -->
  <div class="bg-gray-50 py-3 border-b border-gray-200">
    <div class="container-custom">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- Blog Grid Section -->
  <section class="section py-12 bg-[#f0f4f8] min-h-screen">
    <div class="container-custom">
      
      {posts.length === 0 ? (
        <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-gray-100">
          <p class="text-xl text-gray-500 font-semibold">No blog posts published yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(p => (
            <a href={`/blog/${p.slug}`} class="group bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-lg transition-all block overflow-hidden flex flex-col h-full">
              
              <!-- Blog Image / Placeholder -->
              <div class="relative overflow-hidden h-48 bg-[#f0f4f8] border-b border-gray-100 flex items-center justify-center">
                {p.data.image ? (
                  <img src={p.data.image} alt={p.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                ) : (
                  <svg class="w-16 h-16 text-[#829ab1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                  </svg>
                )}
                {p.data.category && (
                  <div class="absolute top-4 left-4">
                    <span class="bg-[#22c55e] text-white px-3 py-1 rounded-full text-xs font-bold shadow-sm uppercase tracking-wider">
                      {p.data.category}
                    </span>
                  </div>
                )}
              </div>

              <!-- Blog Content -->
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl font-bold text-[#102a43] mb-3 group-hover:text-[#2a4365] transition-colors line-clamp-2">
                  {p.data.title}
                </h3>
                <p class="text-gray-600 mb-4 line-clamp-3 flex-grow">
                  {p.data.description}
                </p>
                
                <!-- Footer with Date and Author -->
                <div class="flex items-center justify-between text-sm mt-auto pt-4 border-t border-gray-100">
                  <div class="flex flex-col">
                    <span class="text-gray-500 font-medium">
                      {new Date(p.data.publishDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                    </span>
                  </div>
                  <span class="text-[#2a4365] group-hover:text-[#22c55e] font-bold inline-flex items-center">
                    Read More 
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  </span>
                </div>
              </div>
              
            </a>
          ))}
        </div>
      )}
      
    </div>
  </section>
</Layout>