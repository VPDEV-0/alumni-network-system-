---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(p => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props as { slug: string };
const post = await getEntry('blog', slug);
const { Content } = await post.render();
const data = post?.data as any;
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: data.title },
];
---

<Layout title={`${data.title} | Sahyadri Alumni Network`} description={data.description} image={data.image}>
  
  <!-- Breadcrumbs Area -->
  <div class="bg-gray-50 py-3 border-b border-gray-200">
    <div class="container-custom">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <!-- Blog Header -->
  <section class="bg-gradient-to-r from-[#0b1e36] to-[#2a4365] text-white py-16">
    <div class="container-custom max-w-4xl mx-auto text-center">
      {data.category && (
        <span class="inline-block bg-[#22c55e] text-white px-4 py-1 rounded-full text-sm font-bold tracking-wider mb-6 shadow-sm">
          {data.category}
        </span>
      )}
      <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">{data.title}</h1>
      
      <div class="flex flex-wrap items-center justify-center gap-4 text-gray-300 text-sm md:text-base">
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2 text-[#22c55e]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          <span>By {data.author || 'Admin'}</span>
        </div>
        <span class="hidden md:inline text-gray-500">•</span>
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2 text-[#22c55e]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <span>{new Date(data.publishDate).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Content -->
  <section class="section py-12 bg-[#f0f4f8] min-h-screen">
    <div class="container-custom max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        
        {/* Optional Cover Image */}
        {data.image && (
          <img src={data.image} alt={data.title} class="w-full h-auto max-h-[400px] object-cover border-b border-gray-100" />
        )}
        
        <div class="p-8 md:p-12">
          {/* Prose class handles all the markdown styling automatically */}
          <article class="prose prose-lg max-w-none prose-headings:text-[#102a43] prose-a:text-[#2a4365] hover:prose-a:text-[#22c55e] prose-img:rounded-xl">
            <Content />
          </article>
          
          {/* Tags Section */}
          {data.tags && data.tags.length > 0 && (
            <div class="mt-12 pt-6 border-t border-gray-100">
              <h4 class="text-sm font-bold text-gray-500 mb-3 uppercase tracking-wider">Tags</h4>
              <div class="flex flex-wrap gap-2">
                {data.tags.map((tag) => (
                  <span class="bg-[#f0f4f8] text-[#2a4365] px-3 py-1 rounded-md text-sm font-semibold border border-gray-200">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
      
      {/* Back Button */}
      <div class="mt-8 text-center">
        <a href="/blog" class="inline-flex items-center text-[#2a4365] hover:text-[#22c55e] font-bold transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Back to all posts
        </a>
      </div>
    </div>
  </section>
</Layout>