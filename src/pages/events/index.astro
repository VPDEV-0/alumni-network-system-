---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events');
const now = new Date();
const upcoming = events.filter(e => new Date(e.data.date) >= now).sort((a,b)=> new Date(a.data.date).getTime() - new Date(b.data.date).getTime());
const past = events.filter(e => new Date(e.data.date) < now).sort((a,b)=> new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Events' },
];
---

<Layout title="Events | Sahyadri Alumni Network" description="Discover upcoming and past events at Sahyadri College.">
  
  <!-- Page Header (Matches About Page) -->
  <section class="bg-gradient-to-r from-[#0b1e36] to-[#2a4365] text-white py-12">
    <div class="container-custom text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Alumni Events</h1>
      <p class="text-xl text-gray-200 max-w-2xl mx-auto">
        Join us for hackathons, reunions, and professional networking sessions.
      </p>
    </div>
  </section>

  <!-- Breadcrumbs Area -->
  <div class="bg-gray-50 py-3 border-b border-gray-200">
    <div class="container-custom">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="section py-12 bg-[#f0f4f8] min-h-screen">
    <div class="container-custom">
      
      <!-- Custom Tabs -->
      <div class="mb-10 flex gap-4 justify-center md:justify-start">
        <!-- Upcoming button is active by default -->
        <button 
          class="tab-btn px-6 py-2 rounded-lg font-bold border-2 border-[#2a4365] bg-[#2a4365] text-white transition-colors duration-200" 
          data-tab="upcoming"
        >
          Upcoming Events
        </button>
        <button 
          class="tab-btn px-6 py-2 rounded-lg font-bold border-2 border-[#2a4365] bg-transparent text-[#2a4365] hover:bg-gray-200 transition-colors duration-200" 
          data-tab="past"
        >
          Past Events
        </button>
      </div>

      <!-- Upcoming Events Tab -->
      <div id="tab-upcoming">
        {upcoming.length === 0 ? (
           <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-gray-100">
             <p class="text-xl text-gray-500 font-semibold">No upcoming events right now. Check back soon!</p>
           </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {upcoming.map(e => (
              <a href={`/events/${e.data.slug}`} class="group bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-lg transition-all block overflow-hidden flex flex-col h-full">
                {e.data.image && (
                   <img src={e.data.image} alt={e.data.title} class="w-full h-48 object-cover border-b border-gray-100 group-hover:scale-105 transition-transform duration-300" />
                )}
                <div class="p-6 flex flex-col flex-grow">
                  <div class="flex items-center justify-between mb-4">
                    <span class="bg-[#22c55e] text-white px-3 py-1 rounded-full text-xs font-bold shadow-sm uppercase tracking-wider">Upcoming</span>
                    <span class="text-sm font-semibold text-gray-500">{new Date(e.data.date).toDateString()}</span>
                  </div>
                  <h3 class="text-xl font-bold text-[#102a43] mb-3 group-hover:text-[#22c55e] transition-colors">{e.data.title}</h3>
                  <p class="text-gray-600 mb-4 line-clamp-3 flex-grow">{e.data.description}</p>
                  {e.data.location && (
                    <div class="flex items-center text-sm font-medium text-[#2a4365] mt-auto pt-4 border-t border-gray-100">
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                      {e.data.location}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Past Events Tab -->
      <div id="tab-past" class="hidden">
        {past.length === 0 ? (
           <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-gray-100">
             <p class="text-xl text-gray-500 font-semibold">No past events found.</p>
           </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {past.map(e => (
              <a href={`/events/${e.data.slug}`} class="group bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-lg transition-all block overflow-hidden flex flex-col h-full opacity-80 hover:opacity-100">
                {e.data.image && (
                   <img src={e.data.image} alt={e.data.title} class="w-full h-48 object-cover border-b border-gray-100 filter grayscale group-hover:grayscale-0 transition-all duration-300" />
                )}
                <div class="p-6 flex flex-col flex-grow">
                  <div class="flex items-center justify-between mb-4">
                    <span class="bg-[#405a7a] text-white px-3 py-1 rounded-full text-xs font-bold shadow-sm uppercase tracking-wider">Past</span>
                    <span class="text-sm font-semibold text-gray-500">{new Date(e.data.date).toDateString()}</span>
                  </div>
                  <h3 class="text-xl font-bold text-[#102a43] mb-3 group-hover:text-[#2a4365] transition-colors">{e.data.title}</h3>
                  <p class="text-gray-600 mb-4 line-clamp-3 flex-grow">{e.data.description}</p>
                  {e.data.location && (
                    <div class="flex items-center text-sm font-medium text-gray-500 mt-auto pt-4 border-t border-gray-100">
                      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                      {e.data.location}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Script to handle tab switching and button styling -->
  <script>
    const buttons = document.querySelectorAll('.tab-btn');
    const upTab = document.getElementById('tab-upcoming');
    const pastTab = document.getElementById('tab-past');
    
    // Define the Tailwind classes for Active and Inactive states
    const activeClasses = ['bg-[#2a4365]', 'text-white'];
    const inactiveClasses = ['bg-transparent', 'text-[#2a4365]', 'hover:bg-gray-200'];

    buttons.forEach(button => button.addEventListener('click', () => {
      const target = button.getAttribute('data-tab');
      
      // Reset all buttons to inactive state
      buttons.forEach(btn => {
        btn.classList.remove(...activeClasses);
        btn.classList.add(...inactiveClasses);
      });
      
      // Set the clicked button to active state
      button.classList.remove(...inactiveClasses);
      button.classList.add(...activeClasses);
      
      // Show/Hide the relevant tab content
      if (target === 'upcoming') { 
        if(upTab) upTab.classList.remove('hidden'); 
        if(pastTab) pastTab.classList.add('hidden'); 
      } else { 
        if(pastTab) pastTab.classList.remove('hidden'); 
        if(upTab) upTab.classList.add('hidden'); 
      }
    }));
  </script>
</Layout>